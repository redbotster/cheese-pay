# 1Claw
ONECLAW_API_BASE=https://api.1claw.xyz
ONECLAW_PLATFORM_APP_ID=          # Cheese Pay platform app
ONECLAW_SPENDER_AGENT_ID=         # the Cheese Pay agent (created by scripts/provision-spender.ts)
ONECLAW_SPENDER_API_KEY=          # sensitive
SPENDER_ADDRESS=                  # the agent's Base address; holds tips waiting for new users
# X (identity only)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://cheesepay.me/api/auth/x/callback
X_BEARER_TOKEN=                   # handle lookups
# App
APP_URL=https://cheesepay.me
SESSION_SECRET=                   # 32+ random chars; also derives the token-at-rest key
CRON_SECRET=                      # Vercel cron bearer
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
