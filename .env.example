# X OAuth2 app (developer.x.com): callback = X_REDIRECT_URI
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://cheesepay.me/api/auth/x/callback   # local testing: http://localhost:8080/callback + scripts/local-relay.ts
SESSION_SECRET=            # 32+ random chars
# The "spender" is a 1Claw agent (key held by 1Claw, guardrails enforced there). Created by:
#   ONE_CLAW_API_KEY=... node --experimental-strip-types scripts/provision-spender.ts --apply
ONECLAW_SPENDER_AGENT_ID=
ONECLAW_SPENDER_API_KEY=
SPENDER_ADDRESS=
NEXT_PUBLIC_SPENDER_ADDRESS=
BASE_RPC_URL=https://mainnet.base.org
APP_URL=https://1claw.co   # where the site is served; used for the post-login redirect
